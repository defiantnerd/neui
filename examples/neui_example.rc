// Application resource script.
//
// Embeds neui_example.manifest as a CREATEPROCESS_MANIFEST_RESOURCE_ID
// (= 1) of type RT_MANIFEST (= 24). The Windows loader reads this
// resource at process startup so the manifest's compatibility section,
// DPI awareness, and UTF-8 ACP declarations are honoured.
//
// We do this via an .rc file (rather than link.exe's /MANIFESTINPUT)
// because MSBuild's auto-manifest generation produces a competing
// MANIFEST resource - combining the two causes link.exe to fail with
// "duplicate resource. type:MANIFEST, name:1, …".

#include <winuser.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "neui_example.manifest"

// Example bitmaps embedded as user-defined "PNG" resources. The name is
// the same string the example passes to set_text() on the IMAGE widget;
// the xpl host's platform_load_image looks them up via
// FindResourceW(L"\"name\"", L"PNG") and decodes from the embedded
// buffer via WIC. rc.exe quirk: quoted resource names are stored with
// the literal quote characters baked into the name, so retrieval has to
// wrap the lookup string in quotes too. `@2x` is auto-picked by the
// asset manager on HiDPI monitors.
"myimage.png"     PNG "myimage.png"
"myimage@2x.png"  PNG "myimage@2x.png"
